{
  "name": "milo",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "milo": "bun src/cli.ts",
    "test": "bun test",
    "lint": "biome check .",
    "lint:ci": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target=bun --outdir=dist",
    "mutate": "stryker run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
